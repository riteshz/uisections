---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import { totals } from '../../lib/data';
import { breadcrumbNode, graph, organizationNode } from '../../lib/jsonld';
import { SITE } from '../../lib/site';
import { absolute } from '../../lib/urls';

const path = '/about/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];

const h1 = 'About UI Sections';
const title = 'About UI Sections — a library of real website sections';
const description =
  'How UI Sections collects and organises real website sections — heroes, pricing, features, footers and more — by section type, style, industry and company.';
const intro =
  'UI Sections is a library of real website sections — heroes, features, pricing, testimonials, footers and the rest — captured from live sites and organised so you can compare how teams design each part of a page.';

const updated = new Date(totals.updated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const stats = [
  { n: totals.sections, label: 'sections' },
  { n: totals.companies, label: 'companies' },
  { n: totals.categories, label: 'section types' },
  { n: totals.styles, label: 'styles' },
];
const ways = [
  { href: '/categories/', icon: 'layers', title: 'By section type', body: 'Designing a pricing table or a footer? Compare every example of that section side by side.' },
  { href: '/tags/', icon: 'sparkle', title: 'By style', body: 'Have a look in mind? Browse styles, or filter any section type by style.' },
  { href: '/industries/', icon: 'briefcase', title: 'By industry', body: 'Compare how fintech, AI, developer tools and other markets present themselves.' },
  { href: '/companies/', icon: 'building', title: 'By company', body: 'See how one company designs its whole site, section by section.' },
] as const;

const pageUrl = absolute(path);
const jsonld = graph(
  breadcrumbNode(crumbs),
  {
    '@type': 'AboutPage',
    '@id': `${pageUrl}#page`,
    url: pageUrl,
    name: h1,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
    breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    inLanguage: 'en',
    dateModified: totals.updated,
  },
  organizationNode(),
);
---
<BaseLayout title={title} description={description} path={path} jsonld={jsonld}>
  <div class="container">
    <PageIntro crumbs={crumbs} title={h1} intro={intro} />

    <dl class="stats enter enter-4">
      {stats.map((s) => (
        <div>
          <dt class="t-meta">{s.label}</dt>
          <dd class="tabular">{s.n.toLocaleString('en-US')}</dd>
        </div>
      ))}
      <div>
        <dt class="t-meta">last updated</dt>
        <dd class="date"><time datetime={totals.updated}>{updated}</time></dd>
      </div>
    </dl>

    <div class="rows">
      <section class="row" aria-labelledby="what">
        <h2 class="t-h2" id="what">What it is</h2>
        <div class="body">
          <p>Most inspiration sites show whole pages or single components. UI Sections sits in between: one screenshot per section, so you can line up every pricing section or footer and see the patterns.</p>
          <p>It’s made for designers and developers building landing pages and marketing sites who want shipped, real-world examples rather than templates.</p>
        </div>
      </section>

      <section class="row" aria-labelledby="how-collected">
        <h2 class="t-h2" id="how-collected">How sections are collected</h2>
        <div class="body">
          <p>Every image is a screenshot of a live, public website — no mockups, templates or redesigns. Each one shows a single section of a page, captured at desktop width.</p>
          <p>Each section is then organised four ways: by <a href="/categories/">section type</a> (what the section does), by <a href="/tags/">style</a> (how it looks), by <a href="/industries/">industry</a> (the market the company serves) and by <a href="/companies/">company</a> (every section from the same site, together).</p>
          <p>Tagging is AI-assisted. A model labels each screenshot against a written definition for every section type and style, and a person reviews the results before they’re published. A section type or style only gets its own page once there are enough examples to be useful.</p>
        </div>
      </section>

      <section class="row" aria-labelledby="how-to-use">
        <h2 class="t-h2" id="how-to-use">How to use it</h2>
        <div class="body">
          <ul class="ways">
            {ways.map((w) => (
              <li>
                <a class="way" href={w.href}>
                  <span class="way-icon"><Icon name={w.icon} size={18} /></span>
                  <span class="way-title">{w.title}<Icon name="arrow-right" size={16} class="way-arrow" /></span>
                  <span class="way-body">{w.body}</span>
                </a>
              </li>
            ))}
          </ul>
          <p>Click any screenshot to open it full size, use <kbd class="kbd">←</kbd> <kbd class="kbd">→</kbd> to move between sections and <kbd class="kbd">Esc</kbd> to close. Press <kbd class="kbd">/</kbd> anywhere to search (or <kbd class="kbd">⌘K</kbd> / <kbd class="kbd">Ctrl K</kbd>).</p>
        </div>
      </section>

      <section class="row" id="ownership" aria-labelledby="ownership-title">
        <h2 class="t-h2" id="ownership-title">Ownership</h2>
        <div class="body">
          <p>Screenshots belong to their respective owners. They’re shown here for design reference and commentary, and UI Sections isn’t affiliated with the companies featured.</p>
        </div>
      </section>

      <section class="row" aria-labelledby="colophon">
        <h2 class="t-h2" id="colophon">Colophon</h2>
        <div class="body">
          <p>Built with <a href="https://astro.build/">Astro</a> and hosted on <a href="https://www.cloudflare.com/">Cloudflare</a>. Type is set in Inter. Every page is static HTML, with a little JavaScript for search, filters and the image viewer.</p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .stats {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px;
    margin-bottom: 72px; padding: 24px 0; border-block: 1px solid var(--line);
  }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .stats div { display: flex; flex-direction: column-reverse; gap: 2px; }
  .stats dd { font-size: 1.75rem; line-height: 1.15; font-weight: 600; letter-spacing: -0.03em; color: var(--ink); }
  .stats dd.date { font-size: 1.125rem; line-height: 1.9rem; letter-spacing: -0.01em; }

  .rows { display: grid; }
  .row { display: grid; gap: 16px; padding-block: 40px; border-top: 1px solid var(--line); }
  .row:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 900px) { .row { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; padding-block: 48px; } }
  .body { display: grid; gap: 16px; max-width: 680px; color: var(--ink-3); line-height: 1.6; }
  .body a:not(.btn):not(.way) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; transition: text-decoration-color 0.15s; }
  .body a:not(.btn):not(.way):hover { text-decoration-color: currentColor; }
  .body .kbd { vertical-align: 1px; }

  .ways { display: grid; gap: 12px; margin-bottom: 8px; }
  @media (min-width: 640px) { .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .way {
    display: grid; gap: 6px; align-content: start; height: 100%; padding: 18px; border-radius: 20px;
    background: var(--wash); color: var(--ink-3); line-height: 1.45; transition: background-color 0.3s var(--ease-out);
  }
  .way:hover { background: var(--wash-hover); }
  .way:active { scale: 0.99; }
  .way-icon { display: grid; place-items: center; width: 36px; height: 36px; margin-bottom: 8px; border-radius: 999px; background: #fff; color: var(--ink-2); box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.08); }
  .way-title { display: inline-flex; align-items: center; gap: 6px; font-weight: 580; color: var(--ink); transition: gap 0.2s var(--ease-spring); }
  .way:hover .way-title { gap: 9px; }
  .way-title :global(.way-arrow) { color: var(--ink-4); }
  .way-body { font-size: 0.875rem; }

</style>
