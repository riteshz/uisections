---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE } from '../lib/site';
import { absolute } from '../lib/urls';

// Content hashes from scripts/og-images.mjs bust social-preview caches.
const ogFiles = import.meta.glob<{ default: Record<string, string> }>('../data/og.json', { eager: true });
const ogVersions = Object.values(ogFiles)[0]?.default ?? {};

interface Props {
  title: string;
  description: string;
  /** Canonical path (defaults to the current URL path). */
  path?: string;
  /** Path to a 1200×630 JPEG in /og/. */
  ogImage?: string;
  ogAlt?: string;
  noindex?: boolean;
  /** 404 and similar pages should not declare a canonical URL. */
  canonical?: boolean;
  jsonld?: object;
}

const { title, description, ogImage = '/og/default.jpg', ogAlt = SITE.tagline, noindex = false, canonical: withCanonical = true, jsonld } = Astro.props;
const path = Astro.props.path ?? Astro.url.pathname;
const canonical = absolute(path);
const og = absolute(ogImage) + (ogVersions[ogImage] ? `?v=${ogVersions[ogImage]}` : '');
// Escape "<" so JSON-LD can never close its script tag.
const ld = jsonld ? JSON.stringify(jsonld).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <Font cssVariable="--font-inter" preload />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="sheet">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <Lightbox />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    left: 16px;
    top: 12px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: var(--r-btn);
    corner-shape: squircle;
    background: var(--ink);
    color: #fff;
    font-weight: 550;
    translate: 0 -150%;
    transition: translate 0.2s var(--ease-out-expo);
  }
  .skip-link:focus-visible { translate: 0 0; }
</style>
