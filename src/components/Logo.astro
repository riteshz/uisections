---
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="currentColor" />
  <rect x="7" y="8" width="18" height="5" rx="1.75" fill="#fff" />
  <rect x="7" y="15" width="18" height="3" rx="1.25" fill="#fff" opacity=".62" />
  <rect x="7" y="20" width="11" height="3" rx="1.25" fill="#fff" opacity=".38" />
</svg>
