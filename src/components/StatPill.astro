---
// Rotating social-proof pill (bencho): CSS-only, pauses on the reduced-motion setting.
interface Props { items: string[] }
const { items } = Astro.props;
---
<p class="stat-pill">
  <span class="dot" aria-hidden="true"></span>
  <span class="sr-only">{items.join(' · ')}</span>
  <span class="window" aria-hidden="true">
    <span class="reel">{[...items, items[0]].map((t) => <span>{t}</span>)}</span>
  </span>
</p>
<style>
  .stat-pill {
    display: inline-flex; align-items: center; gap: 10px; height: 38px; padding: 0 16px 0 14px; border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--ink-rgb) / 0.12); font-size: 0.875rem; font-weight: 520; color: var(--ink-2);
  }
  .dot { position: relative; width: 6px; height: 6px; border-radius: 50%; background: #15803d; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; }
  .window { display: block; height: 1.25rem; line-height: 1.25rem; overflow: hidden; }
  .reel { display: flex; flex-direction: column; }
  @media (prefers-reduced-motion: no-preference) {
    .reel { animation: reel 9s cubic-bezier(0.3, 0.9, 0.3, 1) infinite; }
    .dot::after { animation: beat 2.6s cubic-bezier(0.22, 0.61, 0.36, 1) infinite; }
  }
  @keyframes reel {
    0%, 28% { transform: translateY(0); }
    33%, 61% { transform: translateY(-1.25rem); }
    66%, 94% { transform: translateY(-2.5rem); }
    100% { transform: translateY(-3.75rem); }
  }
  @keyframes beat { 0% { opacity: 0.5; scale: 1; } 70%, 100% { opacity: 0; scale: 2.8; } }
</style>
