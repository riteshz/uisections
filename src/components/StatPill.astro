---
// Rotating stats pill (bencho-style): the pill's width eases to fit each
// phrase while the next phrase slides up. Screen readers get one static line;
// without JS or with reduced motion only the first phrase shows.
interface Props { items: string[] }
const { items } = Astro.props;
---
<p class="stat-pill" data-stat-pill>
  <span class="dot" aria-hidden="true"></span>
  <span class="sr-only">{items.join(' · ')}</span>
  <span class="window" aria-hidden="true" data-window>
    {items.map((t, i) => <span class:list={['item', { 'is-on': i === 0 }]}>{t}</span>)}
  </span>
</p>

<style>
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 34px;
    padding: 0 14px 0 12px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(var(--ink-rgb) / 0.1), 0 1px 2px rgb(var(--ink-rgb) / 0.04);
    font-size: 0.8125rem;
    font-weight: 540;
    letter-spacing: 0.005em;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* Live dot with a soft expanding ring. */
  .dot { position: relative; flex: none; width: 6px; height: 6px; border-radius: 50%; background: #16a34a; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; opacity: 0; }

  /* Stacked phrases; only .is-on is visible. Width is set by the script. */
  .window {
    position: relative;
    display: grid;
    height: 20px;
    overflow: hidden;
    transition: width 0.4s cubic-bezier(0.33, 0.55, 0.2, 1);
  }
  .item {
    grid-area: 1 / 1;
    justify-self: start;
    width: max-content;
    line-height: 20px;
    white-space: nowrap;
    opacity: 0;
    translate: 0 100%;
  }
  .item.is-on { opacity: 1; translate: 0 0; }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after { animation: beat 2.6s cubic-bezier(0.22, 0.61, 0.36, 1) infinite; }
    .item { transition: translate 0.46s cubic-bezier(0.3, 0.9, 0.3, 1), opacity 0.3s ease; }
    .item.is-off { opacity: 0; translate: 0 -100%; transition-duration: 0.36s, 0.2s; }
  }
  @keyframes beat {
    0% { opacity: 0.45; scale: 1; }
    70%, 100% { opacity: 0; scale: 2.8; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  for (const pill of document.querySelectorAll<HTMLElement>('[data-stat-pill]')) {
    const win = pill.querySelector<HTMLElement>('[data-window]')!;
    const items = [...win.children] as HTMLElement[];
    if (items.length < 2) continue;

    // Measure each phrase once (they share one grid cell, so offsetWidth is exact).
    const widths = () => items.map((el) => Math.ceil(el.scrollWidth));
    let i = 0;
    let w = widths();
    win.style.width = `${w[0]}px`;
    // Re-measure once Inter has loaded (the fallback font has different widths).
    document.fonts?.ready.then(() => { w = widths(); win.style.width = `${w[i]}px`; });

    let timer = 0;
    let visible = true;
    const next = () => {
      const prev = items[i];
      i = (i + 1) % items.length;
      const cur = items[i];
      // Reset the incoming phrase below the window without animating, then slide it in.
      cur.classList.remove('is-off');
      prev.classList.remove('is-on');
      prev.classList.add('is-off');
      cur.classList.add('is-on');
      win.style.width = `${w[i]}px`;
      setTimeout(() => prev.classList.remove('is-off'), 500);
    };
    const start = () => { if (!timer && visible && !document.hidden && !reduce.matches) timer = window.setInterval(next, 3000); };
    const stop = () => { clearInterval(timer); timer = 0; };

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(pill);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));
    start();
  }
</script>
