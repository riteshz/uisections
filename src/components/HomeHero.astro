---
// Home hero: rotating stats pill, display H1, sub, two CTAs and a company-name rotator.
import StatPill from './StatPill.astro';
import Icon from './Icon.astro';

interface Props {
  pill: string[];
  title: string;
  sub: string;
  /** Exactly six company names for the blur cross-fade rotator (skipped otherwise). */
  names: string[];
  /** Total number of companies in the library. */
  companyTotal: number;
}

const { pill, title, sub, names, companyTotal } = Astro.props;
const rotator = names.length >= 6 ? names.slice(0, 6) : [];
const others = companyTotal - 1;
---
<section class="home-hero container" aria-labelledby="home-title">
  <div class="enter enter-1"><StatPill items={pill} /></div>
  <h1 class="t-display enter-solid enter-2" id="home-title">{title}</h1>
  <p class="t-feature sub enter enter-3">{sub}</p>
  <div class="ctas enter enter-4">
    <a class="btn btn-primary" href="/categories/">Browse sections<Icon name="arrow-right" size={16} /></a>
    <a class="btn btn-secondary" href="/tags/">Explore styles</a>
  </div>
  {rotator.length > 0 && (
    <p class="from t-meta enter enter-5">
      <span class="sr-only">{`Featuring sections from ${rotator.join(', ')} and ${companyTotal - rotator.length} other companies.`}</span>
      <span class="line" aria-hidden="true">
        Featuring <span class="rot">{rotator.map((n) => <span>{n}</span>)}</span> and {others} more
      </span>
    </p>
  )}
</section>

<style>
  .home-hero {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: calc(900px + 2 * var(--gutter));
    padding-top: clamp(48px, 2rem + 4vw, 104px);
  }
  h1 { margin-top: 24px; }
  .sub { max-width: 600px; margin-top: 18px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 32px; }
  .from { margin-top: 22px; }
  .line { display: inline-flex; align-items: baseline; flex-wrap: wrap; justify-content: center; gap: 0 0.3em; }

  /* Company rotator: names share one grid cell, so the width never jumps. */
  .rot { display: inline-grid; color: var(--ink-2); font-weight: 560; }
  .rot > span { grid-area: 1 / 1; justify-self: center; white-space: nowrap; }
  .rot > span:not(:first-child) { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .rot > span { animation: co-swap 15s var(--ease-out) infinite both; }
    .rot > span:nth-child(1) { animation-delay: -0.75s; }
    .rot > span:nth-child(2) { animation-delay: 1.75s; }
    .rot > span:nth-child(3) { animation-delay: 4.25s; }
    .rot > span:nth-child(4) { animation-delay: 6.75s; }
    .rot > span:nth-child(5) { animation-delay: 9.25s; }
    .rot > span:nth-child(6) { animation-delay: 11.75s; }
  }
  @keyframes co-swap {
    0% { opacity: 0; filter: blur(4px); transform: translateY(8px); }
    4%, 15% { opacity: 1; filter: blur(0); transform: none; }
    18.5%, 100% { opacity: 0; filter: blur(4px); transform: translateY(-8px); }
  }
</style>
