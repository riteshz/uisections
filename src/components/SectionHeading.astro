---
import Icon from './Icon.astro';
interface Props { title: string; id?: string; href?: string; linkLabel?: string; sub?: string }
const { title, id, href, linkLabel = 'View all', sub } = Astro.props;
---
<div class="sec-head">
  <div>
    <h2 class="t-h2" id={id}>{title}</h2>
    {sub && <p class="t-meta">{sub}</p>}
  </div>
  {href && <a class="more" href={href}>{linkLabel}<Icon name="arrow-right" size={16} /></a>}
</div>
<style>
  .sec-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .sec-head p { margin-top: 4px; }
  .more { display: inline-flex; align-items: center; gap: 6px; flex: none; font-size: 0.9375rem; font-weight: 550; color: var(--ink-3); transition: color 0.15s, gap 0.2s var(--ease-spring); }
  .more:hover { color: var(--ink); gap: 9px; }
</style>
