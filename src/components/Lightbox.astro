---
import Icon from './Icon.astro';
import { allCategories, tags } from '../lib/data';

// Labels + URLs the viewer needs to render chips for any card on the page
// (tags also carry their facet, which groups them in "Copy as prompt").
const taxonomy = {
  c: Object.fromEntries(allCategories.map((c) => [c.id, [c.label, c.hasPage ? c.path : '']])),
  t: Object.fromEntries(tags.map((t) => [t.id, [t.label, t.hasPage ? t.path : '', t.facet]])),
};
---
<dialog class="lb" data-lb aria-labelledby="lb-title">
  <div class="lb-panel" data-lb-panel>
    <div class="lb-bar">
      <div class="lb-id">
        <span class="lb-avatar" data-lb-avatar aria-hidden="true">U</span>
        <div class="lb-names">
          <h2 id="lb-title" class="lb-title" data-lb-title>Section preview</h2>
          <p class="lb-sub" data-lb-sub>Website section</p>
        </div>
      </div>
      <div class="lb-bar-actions">
        <div class="lb-copy" data-lb-copy>
          <button type="button" class="lb-copy-main" data-lb-copy-main aria-label="Copy image">
            <span class="lb-copy-ic" aria-hidden="true"><Icon name="copy" size={16} /><Icon name="check" size={16} /></span>
            <span class="lb-copy-label" data-label>Copy</span>
          </button>
          <button type="button" class="lb-copy-toggle" data-lb-copy-toggle aria-label="More copy options" aria-haspopup="menu" aria-expanded="false" aria-controls="lb-copy-menu">
            <Icon name="chevron-down" size={16} />
          </button>
          <div class="lb-menu" id="lb-copy-menu" role="menu" aria-label="Copy options" data-lb-menu hidden>
            <button type="button" role="menuitem" tabindex="-1" data-lb-act="image">
              <Icon name="image" size={18} /><span><b>Copy image</b><small>Full-size PNG</small></span>
            </button>
            <button type="button" role="menuitem" tabindex="-1" data-lb-act="download">
              <Icon name="download" size={18} /><span><b>Download image</b><small>Full-size WebP</small></span>
            </button>
          </div>
        </div>
        <button type="button" class="btn btn-secondary btn-sm lb-prompt" data-lb-prompt aria-label="Copy as prompt" title="Copy a prompt for v0, Lovable, Cursor or Claude">
          <span class="lb-copy-ic" aria-hidden="true"><Icon name="terminal" size={16} /><Icon name="check" size={16} /></span>
          <span class="lb-prompt-label" data-label>Copy as prompt</span>
        </button>
        <button type="button" class="icon-btn" data-lb-close aria-label="Close preview" aria-keyshortcuts="Escape"><Icon name="x" size={20} /></button>
      </div>
    </div>

    <p class="lb-toast" data-lb-toast role="status" aria-live="polite"></p>

    <div class="lb-stage" data-lb-stage tabindex="-1">
      <img class="lb-img" data-lb-img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1" height="1" alt="" decoding="async" />
    </div>

    <div class="lb-foot">
      <ul class="lb-tags" data-lb-tags aria-label="Section type and styles"></ul>
      <div class="lb-nav">
        <a class="lb-more" href="/companies/" data-lb-company hidden><span data-lb-more-label>More from this company</span><Icon name="arrow-right" size={15} /></a>
        <div class="lb-pager">
          <button type="button" class="icon-btn" data-lb-prev aria-label="Previous section" aria-keyshortcuts="ArrowLeft"><Icon name="arrow-left" size={18} /></button>
          <span class="lb-pos tabular" data-lb-pos aria-live="polite"></span>
          <button type="button" class="icon-btn" data-lb-next aria-label="Next section" aria-keyshortcuts="ArrowRight"><Icon name="arrow-right" size={18} /></button>
        </div>
      </div>
    </div>
  </div>

  <button type="button" class="lb-arrow prev" data-lb-prev aria-label="Previous section" tabindex="-1"><Icon name="arrow-left" size={20} /></button>
  <button type="button" class="lb-arrow next" data-lb-next aria-label="Next section" tabindex="-1"><Icon name="arrow-right" size={20} /></button>
</dialog>
<script type="application/json" id="ui-taxonomy" set:html={JSON.stringify(taxonomy)} />

<style is:global>
  html:has(dialog[open]) { overflow: hidden; }

  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 24px 88px;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop {
    background: rgb(12 12 14 / 0.62);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    backdrop-filter: blur(10px) saturate(120%);
  }
  .lb[open]::backdrop { animation: lb-fade 0.28s var(--ease-out) both; }
  .lb.is-closing::backdrop { animation: lb-fade-out 0.2s var(--ease-out) both; }

  .lb-panel {
    display: grid;
    /* minmax(0, 1fr): long one-line text truncates instead of widening the panel. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: min(1180px, 100%);
    height: 100%;
    border-radius: 24px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 32px 80px -24px rgb(0 0 0 / 0.5);
  }
  .lb[open] .lb-panel { animation: lb-in 0.42s var(--ease-out-expo) both; }
  .lb.is-closing .lb-panel { animation: lb-out 0.2s var(--ease-out) both; }

  /* Header */
  .lb-bar {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 14px 14px 20px;
    border-bottom: 1px solid var(--line);
  }
  .lb-id { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .lb-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 620;
  }
  .lb-names { min-width: 0; }
  .lb-title { font-size: 1rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lb-sub { font-size: 0.8125rem; line-height: 1.35; color: var(--ink-4); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lb-bar-actions { display: flex; align-items: center; gap: 6px; flex: none; }

  /* Copy split button: the main half copies the image, the chevron opens more options. */
  .lb-copy { position: relative; display: flex; }
  .lb-copy-main,
  .lb-copy-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    background: var(--ink);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.15s var(--ease-out), scale 0.2s var(--ease-spring);
  }
  .lb-copy { border-radius: var(--r-btn-sm); }
  .lb-copy-main, .lb-copy-toggle { corner-shape: squircle; }
  .lb-copy-main { gap: 7px; padding: 0 12px 0 13px; border-radius: var(--r-btn-sm) 0 0 var(--r-btn-sm); font-size: 0.875rem; font-weight: 550; white-space: nowrap; }
  .lb-copy-toggle { width: 32px; padding-right: 2px; border-radius: 0 var(--r-btn-sm) var(--r-btn-sm) 0; box-shadow: inset 1px 0 0 rgb(255 255 255 / 0.16); }
  .lb-copy-toggle svg { transition: rotate 0.28s var(--ease-soft); }
  .lb-copy-toggle[aria-expanded="true"] svg { rotate: 180deg; }
  .lb-copy-main:active, .lb-copy-toggle:active { scale: 0.96; transition-duration: 90ms; }
  .lb .is-busy { cursor: progress; }
  .lb .is-busy .lb-copy-ic { animation: lb-pulse 0.9s ease-in-out infinite alternate; }
  .lb-copy-ic { display: grid; }
  .lb-copy-ic > svg { grid-area: 1 / 1; transition: opacity 0.16s, scale 0.3s var(--ease-spring); }
  .lb-copy-ic > svg:last-child { opacity: 0; scale: 0.5; }
  .lb .is-done .lb-copy-ic > svg:first-child { opacity: 0; scale: 0.5; }
  .lb .is-done .lb-copy-ic > svg:last-child { opacity: 1; scale: 1; }
  .lb-prompt { gap: 7px; padding: 0 14px 0 12px; }
  @media (hover: hover) {
    .lb-copy-main:hover, .lb-copy-toggle:hover, .lb-copy-toggle[aria-expanded="true"] { background: #2e2f33; }
  }

  .lb-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 5;
    width: 264px;
    padding: 6px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.07), 0 18px 44px -14px rgb(0 0 0 / 0.3), 0 4px 10px -4px rgb(0 0 0 / 0.08);
    transform-origin: top right;
    animation: lb-menu-in 0.24s var(--ease-out-expo) both;
  }
  .lb-menu[hidden] { display: none; }
  .lb-menu button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 8px 10px;
    border-radius: var(--r-btn-sm);
    corner-shape: squircle;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    outline: none;
    transition: background-color 0.12s;
  }
  .lb-menu button > svg { flex: none; color: var(--ink-4); transition: color 0.12s; }
  .lb-menu button:hover, .lb-menu button:focus-visible { background: var(--wash); }
  .lb-menu button:hover > svg, .lb-menu button:focus-visible > svg { color: var(--ink); }
  .lb-menu b { display: block; font-size: 0.9375rem; line-height: 1.3; font-weight: 550; }
  .lb-menu small { display: block; font-size: 0.75rem; line-height: 1.35; color: var(--ink-4); }

  /* Confirmation toast, just under the header. */
  .lb-panel { position: relative; }
  .lb-toast {
    position: absolute;
    top: 76px;
    left: 0;
    right: 0;
    z-index: 4;
    width: max-content;
    max-width: calc(100% - 32px);
    margin-inline: auto;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 520;
    text-align: center;
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.45);
    pointer-events: none;
    opacity: 0;
    translate: 0 -8px;
    transition: opacity 0.2s var(--ease-out), translate 0.36s var(--ease-out-expo);
  }
  .lb-toast.is-on { opacity: 1; translate: 0 0; }

  /* Stage */
  .lb-stage {
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 28px;
    background: var(--surface);
    outline: none;
    scrollbar-width: thin;
  }
  .lb-img {
    flex: none; /* never shrink: tall screenshots scroll inside the stage */
    display: block;
    width: 100%;
    max-width: 1100px;
    height: auto;
    margin-inline: auto;
    border-radius: 12px;
    background-color: var(--wash);
    background-size: 100% auto;
    background-repeat: no-repeat;
    background-position: top center;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.1), 0 16px 40px -20px rgb(0 0 0 / 0.25);
  }
  .lb-img.is-swapping { animation: lb-swap 0.32s var(--ease-out-expo) both; }
  .lb-img.from-left { --dx: -14px; }
  .lb-img.from-right { --dx: 14px; }

  /* Footer */
  .lb-foot {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 14px 12px 20px;
    border-top: 1px solid var(--line);
  }
  .lb-tags { display: flex; gap: 6px; min-width: 0; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, #000 calc(100% - 24px), transparent); }
  .lb-tags::-webkit-scrollbar { display: none; }
  .lb-tags li { flex: none; }
  .lb-tags .tag.is-category { background: var(--ink); color: #fff; }
  .lb-nav { display: flex; align-items: center; gap: 14px; flex: none; }
  .lb-more { display: inline-flex; align-items: center; gap: 6px; font-size: 0.875rem; font-weight: 550; color: var(--ink-2); transition: color 0.15s, gap 0.2s var(--ease-spring); white-space: nowrap; }
  .lb-more:hover { color: var(--ink); gap: 9px; }
  .lb-more[hidden] { display: none; }
  .lb-pager { display: flex; align-items: center; gap: 2px; padding-left: 14px; border-left: 1px solid var(--line); }
  .lb-pos { min-width: 64px; text-align: center; font-size: 0.8125rem; color: var(--ink-4); }

  /* Floating arrows (desktop) */
  .lb-arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: calc(var(--r-btn) + 2px);
    corner-shape: squircle;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background-color 0.18s, scale 0.26s var(--ease-soft);
  }
  .lb-arrow:hover { background: rgb(255 255 255 / 0.26); scale: 1.06; }
  .lb-arrow:active { scale: 0.94; transition-duration: 90ms; }
  .lb-arrow.prev { left: 20px; }
  .lb-arrow.next { right: 20px; }
  .lb[open] .lb-arrow { animation: lb-fade 0.3s var(--ease-out) 0.12s both; }

  @keyframes lb-fade { from { opacity: 0; } }
  @keyframes lb-fade-out { to { opacity: 0; } }
  @keyframes lb-in { from { opacity: 0; transform: translateY(18px) scale(0.985); } }
  @keyframes lb-out { to { opacity: 0; transform: translateY(8px) scale(0.99); } }
  @keyframes lb-up { from { transform: translateY(100%); } }
  @keyframes lb-down { to { transform: translateY(100%); } }
  @keyframes lb-swap { from { opacity: 0.35; transform: translateX(var(--dx, 0)); } }
  @keyframes lb-menu-in { from { opacity: 0; transform: translateY(-6px) scale(0.96); } }
  @keyframes lb-pulse { to { opacity: 0.4; } }

  @media (max-width: 1100px) {
    .lb { padding: 20px; }
    .lb-arrow { display: none; }
  }
  @media (max-width: 720px) {
    .lb { padding: 0; }
    /* Full-screen blur is costly on phones; a darker plain scrim reads the same. */
    .lb::backdrop { background: rgb(12 12 14 / 0.72); -webkit-backdrop-filter: none; backdrop-filter: none; }
    .lb-bar .icon-btn, .lb-pager .icon-btn { width: 44px; height: 44px; }
    .lb-stage { touch-action: pan-y; }
    .lb[open] { place-items: end stretch; }
    .lb-panel { width: 100%; height: calc(100dvh - 12px); border-radius: 20px 20px 0 0; }
    .lb[open] .lb-panel { animation: lb-up 0.44s var(--ease-out-expo) both; }
    .lb.is-closing .lb-panel { animation: lb-down 0.24s var(--ease-out) both; }
    .lb-bar { padding: 10px 8px 10px 14px; }
    .lb-copy-label, .lb-prompt-label { display: none; }
    .lb-prompt { width: 40px; height: 40px; padding: 0; }
    .lb-copy-main, .lb-copy-toggle { height: 40px; }
    .lb-copy-main { padding: 0 10px 0 14px; }
    .lb-copy-toggle { width: 34px; }
    .lb-menu button { padding: 10px 12px; }
    .lb-stage { padding: 12px; }
    .lb-foot { flex-direction: column; align-items: stretch; gap: 10px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); }
    .lb-nav { justify-content: space-between; }
    .lb-pager { border-left: 0; padding-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-img.is-swapping, .lb-menu, .lb .is-busy .lb-copy-ic { animation: none; }
    .lb-toast { transition: opacity 0.2s; translate: 0 0; }
  }
</style>

<script>
  type Taxonomy = { c: Record<string, [string, string]>; t: Record<string, [string, string, string?]> };
  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-lb]')!;
  const taxonomy: Taxonomy = JSON.parse(document.getElementById('ui-taxonomy')?.textContent || '{"c":{},"t":{}}');

  if (dialog) {
    const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
    const stage = $<HTMLElement>('[data-lb-stage]');
    const img = $<HTMLImageElement>('[data-lb-img]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let current: HTMLElement | null = null;
    let currentA: HTMLAnchorElement | null = null;
    let pushed = false;
    let closing = false;

    const anchors = () => [...document.querySelectorAll<HTMLAnchorElement>('li.card:not([hidden]) a[data-lightbox]')];
    const cardOf = (a: HTMLAnchorElement) => a.closest<HTMLElement>('[data-id]')!;
    const anchorById = (id: string) => document.querySelector<HTMLAnchorElement>(`[data-id="${CSS.escape(id)}"] a[data-lightbox]`);
    const srcFor = (a: HTMLAnchorElement) => (a.dataset.md && innerWidth < 900 ? a.dataset.md : a.href);

    function chip(label: string, href: string, isCategory = false) {
      const li = document.createElement('li');
      const el = document.createElement(href ? 'a' : 'span');
      el.className = isCategory ? 'tag is-category' : 'tag';
      el.textContent = label;
      if (href) (el as HTMLAnchorElement).href = href;
      li.append(el);
      return li;
    }

    function fill(a: HTMLAnchorElement, dir = 0) {
      const card = cardOf(a);
      const [catLabel, catHref] = taxonomy.c[card.dataset.cat ?? ''] ?? ['Website', ''];
      const companyLink = card.querySelector<HTMLAnchorElement>('a.co');
      const name = card.dataset.companyName || card.querySelector('.co')?.textContent || 'Website';
      $('[data-lb-avatar]').textContent = name.replace(/[^\p{L}\p{N}]/gu, '').charAt(0).toUpperCase() || '•';
      $('[data-lb-title]').textContent = name;
      $('[data-lb-sub]').textContent = a.dataset.headline ? `${catLabel} section · “${a.dataset.headline}”` : `${catLabel} section`;
      $('[data-lb-tags]').replaceChildren(
        chip(catLabel, catHref, true),
        ...(card.dataset.tags ?? '').split(' ').filter(Boolean).map((t) => {
          const [label, href] = taxonomy.t[t] ?? [t, ''];
          return chip(label, href);
        }),
      );

      const more = $<HTMLAnchorElement>('[data-lb-company]');
      const samePage = companyLink && location.pathname === new URL(companyLink.href).pathname;
      more.hidden = !companyLink || Boolean(samePage);
      if (companyLink) more.href = companyLink.href;
      $('[data-lb-more-label]').textContent = `More from ${name}`;

      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      img.style.backgroundImage = a.dataset.thumb ? `url("${a.dataset.thumb}")` : '';
      img.alt = card.querySelector('img')?.alt ?? '';
      img.src = srcFor(a);
      if (dir && !reduce.matches) {
        img.classList.remove('is-swapping', 'from-left', 'from-right');
        void img.offsetWidth;
        img.classList.add('is-swapping', dir > 0 ? 'from-right' : 'from-left');
      }

      const list = anchors();
      const i = list.indexOf(a);
      $('[data-lb-pos]').textContent = i >= 0 ? `${i + 1} / ${list.length}` : '';
      for (const n of [list[i - 1], list[i + 1]]) if (n) new Image().src = srcFor(n);
      current = card;
      currentA = a;
      setMenu(false);
      resetCopy();
    }

    function open(a: HTMLAnchorElement, { push = true, dir = 0 } = {}) {
      fill(a, dir);
      stage.scrollTop = 0;
      if (!dialog.open) {
        closing = false;
        dialog.classList.remove('is-closing');
        dialog.showModal();
        stage.focus({ preventScroll: true });
      }
      const hash = `#s-${cardOf(a).dataset.id}`;
      if (push && !pushed) { history.pushState({ lb: true }, '', hash); pushed = true; }
      else history.replaceState(history.state, '', hash);
    }

    function close() {
      if (!dialog.open || closing) return;
      setMenu(false);
      const card = current;
      const finish = () => {
        closing = false;
        dialog.classList.remove('is-closing');
        dialog.close();
        // Return focus to the card that opened the viewer.
        card?.querySelector<HTMLElement>('a[data-lightbox]')?.focus({ preventScroll: true });
      };
      if (reduce.matches) return finish();
      closing = true;
      dialog.classList.add('is-closing');
      setTimeout(finish, 200);
    }

    function closeUI() {
      if (pushed && history.state?.lb) history.back();
      else {
        close();
        history.replaceState(history.state, '', location.pathname + location.search);
      }
    }

    function step(dir: number) {
      const list = anchors();
      const i = list.findIndex((a) => cardOf(a) === current);
      const next = list[(i + dir + list.length) % list.length];
      if (next) {
        open(next, { push: false, dir });
        cardOf(next).scrollIntoView({ block: 'nearest', behavior: 'instant' });
      }
    }

    // --- Copy: image (split button + menu with download) and prompt ----------------
    const copyWrap = $<HTMLElement>('[data-lb-copy]');
    const copyMain = $<HTMLButtonElement>('[data-lb-copy-main]');
    const promptBtn = $<HTMLButtonElement>('[data-lb-prompt]');
    const idleLabels = new Map([[copyMain, 'Copy'], [promptBtn, 'Copy as prompt']]);
    const toggle = $<HTMLButtonElement>('[data-lb-copy-toggle]');
    const menu = $<HTMLElement>('[data-lb-menu]');
    const toast = $<HTMLElement>('[data-lb-toast]');
    const items = () => [...menu.querySelectorAll<HTMLButtonElement>('[role="menuitem"]')];
    const menuOpen = () => !menu.hidden;
    let toastTimer = 0;
    let doneTimer = 0;

    function setMenu(open: boolean, focus?: 'first' | 'last') {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open && focus) items()[focus === 'first' ? 0 : items().length - 1]?.focus();
    }

    function resetCopy() {
      clearTimeout(doneTimer);
      for (const [btn, label] of idleLabels) {
        btn.classList.remove('is-done', 'is-busy');
        btn.querySelector('[data-label]')!.textContent = label;
      }
    }

    /** Shows a short confirmation; `done` also flips that button to a check. */
    function notify(message: string, done?: HTMLButtonElement) {
      clearTimeout(toastTimer);
      resetCopy();
      toast.textContent = message;
      toast.classList.add('is-on');
      toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), 2600);
      if (done) {
        done.classList.add('is-done');
        done.querySelector('[data-label]')!.textContent = 'Copied';
        doneTimer = window.setTimeout(resetCopy, 1800);
      }
    }

    // Clipboards accept images only as PNG, so the WebP is re-encoded first.
    async function pngOf(url: string): Promise<Blob> {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const bitmap = await createImageBitmap(await res.blob());
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0);
      bitmap.close();
      return new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('PNG encode failed'))), 'image/png'));
    }

    async function copyImage() {
      if (!currentA) return;
      if (typeof ClipboardItem === 'undefined' || !navigator.clipboard?.write) {
        notify('This browser can’t copy images. Use Download image instead.');
        return;
      }
      copyMain.classList.add('is-busy');
      try {
        // The item is created inside the click (Safari requires that) with the PNG still pending.
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': pngOf(currentA.href) })]);
        notify('Image copied to clipboard', copyMain);
      } catch {
        notify('Couldn’t copy the image. Try Download image instead.');
      }
    }

    /**
     * The section's palette, most common first: neutrals need a 1.5% share, saturated
     * accents (buttons, highlights) only 0.3%. Same 4-bit buckets as scripts/inventory.mjs.
     */
    function palette(): { hex: string; accent: boolean }[] {
      const source = [img, current?.querySelector('img')].find((el): el is HTMLImageElement => Boolean(el?.complete && el.naturalWidth > 1));
      const bg = current?.style.getPropertyValue('--shot-bg').trim();
      const fallback = bg ? [{ hex: bg, accent: false }] : [];
      if (!source) return fallback;
      try {
        const w = 96;
        const h = Math.max(1, Math.min(240, Math.round((w * source.naturalHeight) / source.naturalWidth)));
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
        ctx.drawImage(source, 0, 0, w, h);
        const px = ctx.getImageData(0, 0, w, h).data;
        const buckets = new Map<number, { n: number; r: number; g: number; b: number }>();
        for (let i = 0; i < px.length; i += 4) {
          const r = px[i], g = px[i + 1], b = px[i + 2];
          const key = ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
          const e = buckets.get(key) ?? { n: 0, r: 0, g: 0, b: 0 };
          e.n++; e.r += r; e.g += g; e.b += b;
          buckets.set(key, e);
        }
        const total = w * h;
        const picked: { rgb: number[]; accent: boolean }[] = [];
        for (const e of [...buckets.values()].sort((x, y) => y.n - x.n)) {
          const rgb = [e.r / e.n, e.g / e.n, e.b / e.n];
          const accent = Math.max(...rgb) - Math.min(...rgb) > 60;
          if (e.n / total < (accent ? 0.003 : 0.015)) continue;
          if (picked.some((p) => Math.hypot(p.rgb[0] - rgb[0], p.rgb[1] - rgb[1], p.rgb[2] - rgb[2]) < 56)) continue;
          picked.push({ rgb, accent });
          if (picked.length === 5) break;
        }
        return picked.map((p) => ({ hex: `#${p.rgb.map((v) => Math.round(v).toString(16).padStart(2, '0')).join('')}`, accent: p.accent }));
      } catch {
        return fallback;
      }
    }

    const FACETS: [string, string][] = [['theme', 'Theme'], ['layout', 'Layout'], ['media', 'Media'], ['treatment', 'Details'], ['type', 'Typography']];

    /** A ready-to-paste brief for AI design and coding tools. */
    function promptFor(a: HTMLAnchorElement, card: HTMLElement) {
      const [catLabel] = taxonomy.c[card.dataset.cat ?? ''] ?? ['Website'];
      const noun = card.dataset.cat === 'faq' ? 'FAQ' : catLabel.toLowerCase();
      const name = card.dataset.companyName ?? '';
      const brand = name && name !== 'Unknown' ? name : '';
      const alt = card.querySelector('img')?.alt ?? '';
      const what = alt.slice(alt.indexOf(': ') + 1).trim(); // drop the "Company category section:" lead-in
      const sentence = what && `${what.charAt(0).toUpperCase()}${what.slice(1)}${/[.!?]$/.test(what) ? '' : '.'}`;
      const byFacet = new Map<string, string[]>();
      for (const id of (card.dataset.tags ?? '').split(' ').filter(Boolean)) {
        const [label, , facet = 'other'] = taxonomy.t[id] ?? [id, ''];
        byFacet.set(facet, [...(byFacet.get(facet) ?? []), label]);
      }
      const style = FACETS.filter(([f]) => byFacet.has(f)).map(([f, title]) => `- ${title}: ${byFacet.get(f)!.join(', ')}`);
      const colours = palette();
      if (colours.length) {
        const label = (c: { hex: string; accent: boolean }, i: number) => (i === 0 ? `${c.hex} (background)` : c.accent ? `${c.hex} (accent)` : c.hex);
        style.push(`- Colours: ${colours.map(label).join(', ')}`);
      }
      const source = brand ? `${brand}’s ${noun} section${card.dataset.domain ? ` (${card.dataset.domain})` : ''}` : 'the reference screenshot';
      return [
        `Build a ${noun} section for a modern website, inspired by ${source}.`,
        '',
        `Reference screenshot: ${a.href}`,
        '',
        'What the reference shows:',
        ...(sentence ? [sentence] : []),
        ...(a.dataset.headline ? [`Headline: “${a.dataset.headline}”`] : []),
        ...(style.length ? ['', 'Visual style:', ...style] : []),
        '',
        'Requirements:',
        '- Match the layout, spacing, visual hierarchy and overall feel of the reference.',
        '- Fully responsive and mobile first, with semantic HTML, accessible colour contrast and visible focus states.',
        '- Use React and Tailwind CSS unless the project already uses another stack.',
        `- Write original copy and use placeholder imagery; don’t reuse ${brand ? `${brand}’s` : 'the reference’s'} logo, brand assets or text.`,
      ].join('\n');
    }

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Older browsers: copy from a hidden textarea (inside the dialog, which is the only interactive layer).
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.className = 'sr-only';
        dialog.append(ta);
        ta.select();
        const ok = document.execCommand('copy');
        ta.remove();
        if (!ok) throw new Error('copy failed');
      }
    }

    async function copyPrompt() {
      if (!currentA || !current) return;
      try {
        await copyText(promptFor(currentA, current));
        notify('Prompt copied. Paste it with the image', promptBtn);
      } catch {
        notify('Couldn’t copy the prompt');
      }
    }

    function download() {
      if (!currentA) return;
      const link = document.createElement('a');
      link.href = currentA.href;
      link.download = (currentA.pathname.split('/').pop() || 'section.webp').replace(/-lg\.webp$/, '.webp');
      dialog.append(link);
      link.click();
      link.remove();
      notify('Download started');
    }

    copyMain.addEventListener('click', () => { setMenu(false); copyImage(); });
    promptBtn.addEventListener('click', () => { setMenu(false); copyPrompt(); });
    toggle.addEventListener('click', () => (menuOpen() ? setMenu(false) : setMenu(true, 'first')));
    toggle.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      setMenu(true, e.key === 'ArrowDown' ? 'first' : 'last');
    });
    copyWrap.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen()) {
        // Handled here so Esc closes only the menu, not the whole viewer.
        e.preventDefault();
        e.stopPropagation();
        setMenu(false);
        toggle.focus();
      }
    });
    menu.addEventListener('keydown', (e) => {
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === 'ArrowDown') list[(i + 1) % list.length].focus();
      else if (e.key === 'ArrowUp') list[(i - 1 + list.length) % list.length].focus();
      else if (e.key === 'Home') list[0].focus();
      else if (e.key === 'End') list[list.length - 1].focus();
      else if (e.key === 'Tab') return setMenu(false);
      else return;
      e.preventDefault();
    });
    menu.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-lb-act]')?.dataset.lbAct;
      if (!act) return;
      setMenu(false);
      toggle.focus({ preventScroll: true });
      if (act === 'image') copyImage();
      else download();
    });

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open(a);
    });
    // Clicks outside the copy menu close it; clicks on the dark scrim close the viewer.
    dialog.addEventListener('click', (e) => {
      if (menuOpen() && !copyWrap.contains(e.target as Node)) setMenu(false);
      if (e.target === dialog) closeUI();
    });
    $('[data-lb-close]').addEventListener('click', closeUI);
    dialog.querySelectorAll('[data-lb-prev]').forEach((b) => b.addEventListener('click', () => step(-1)));
    dialog.querySelectorAll('[data-lb-next]').forEach((b) => b.addEventListener('click', () => step(1)));
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      if (menuOpen()) { setMenu(false); toggle.focus(); }
      else closeUI();
    });
    dialog.addEventListener('keydown', (e) => {
      if (menuOpen()) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    });

    // Touch: swipe left/right on the screenshot to move between sections.
    let touchX = 0, touchY = 0, touchT = 0;
    stage.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      touchX = t.clientX; touchY = t.clientY; touchT = Date.now();
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - touchX, dy = t.clientY - touchY;
      if (Date.now() - touchT < 600 && Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
    }, { passive: true });

    window.addEventListener('popstate', () => {
      const m = location.hash.match(/^#s-([a-f0-9]+)$/);
      const a = m && anchorById(m[1]);
      pushed = false;
      if (a) open(a, { push: false });
      else close();
    });

    // A page restored from the back/forward cache keeps old JS state; reset it.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      pushed = false;
      closing = false;
      dialog.classList.remove('is-closing');
      if (dialog.open) dialog.close();
    });

    // Deep link: /hero-sections/#s-abc123 opens that section.
    const m = location.hash.match(/^#s-([a-f0-9]+)$/);
    const initial = m && anchorById(m[1]);
    if (initial) {
      cardOf(initial).scrollIntoView({ block: 'center', behavior: 'instant' });
      requestAnimationFrame(() => open(initial, { push: false }));
    }
  }
</script>
