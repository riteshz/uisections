---
import type { Section } from '../lib/data';
import { getCategory, getCompany } from '../lib/data';
import { companyUrl, shotUrl } from '../lib/urls';

interface Props {
  s: Section;
  index: number;
  /** Above-the-fold cards load eagerly and never start invisible (LCP). */
  eager?: boolean;
  priority?: boolean;
  sizes?: string;
}

/** Thinner strips than this sit centred on their own background colour. */
const MIN_RATIO = 0.3;

const {
  s,
  index,
  eager = false,
  priority = false,
  sizes = '(min-width: 1100px) 25vw, (min-width: 720px) 33vw, 50vw',
} = Astro.props;
const category = getCategory(s.category)!;
const company = getCompany(s.company);
// The card's box keeps the section's own shape (capped at build time), so nothing shifts as images load.
const natural = s.masonry.h / s.masonry.w;
const ratio = Math.max(natural, MIN_RATIO).toFixed(4);
const fit = natural < MIN_RATIO ? 'contain' : 'cover';
---
<li
  class:list={['card', { eager }]}
  id={`s-${s.id}`}
  data-id={s.id}
  data-cat={s.category}
  data-tags={s.tags.join(' ')}
  data-company={s.company}
  data-company-name={s.companyName}
  data-company-href={company?.hasPage ? companyUrl(s.company) : undefined}
  data-company-count={company?.count}
  data-domain={company?.domain ?? undefined}
  style={`--r:${ratio};--shot-bg:${s.bg};--i:${Math.min(index, 9)}`}
>
  <a
    class="thumb shot"
    href={shotUrl(s.files.lg)}
    data-lightbox
    data-w={s.large.w}
    data-h={s.large.h}
    data-thumb={shotUrl(s.files.m480)}
    data-md={shotUrl(s.files.md)}
    data-headline={s.headline || undefined}
    aria-label={`Open ${s.companyName} ${category.label.toLowerCase()} section`}
  >
    <img
      class={fit}
      src={shotUrl(s.files.m480)}
      srcset={`${shotUrl(s.files.m480)} ${s.masonry.w}w, ${shotUrl(s.files.md)} ${s.medium.w}w`}
      sizes={sizes}
      width={s.masonry.w}
      height={s.masonry.h}
      alt={s.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'auto' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </a>
</li>
