---
import SectionCard from './SectionCard.astro';
import type { Section } from '../lib/data';

interface Props {
  items: Section[];
  id?: string;
  /** How many cards render eagerly (first rows). */
  eagerCount?: number;
  /** Cards that get fetchpriority=high (0 when the grid is below the fold). */
  priorityCount?: number;
  label?: string;
}

// The first row is fetched at high priority: in a masonry row the tallest card is often the LCP.
const { items, id, eagerCount = 8, priorityCount = 4, label } = Astro.props;
---
<ol class="section-grid" id={id} data-grid data-masonry role="list" aria-label={label}>
  {items.map((s, i) => <SectionCard s={s} index={i} eager={i < eagerCount} priority={i < priorityCount} />)}
</ol>
<script is:inline>window.uiMasonry && window.uiMasonry(document.currentScript.previousElementSibling);</script>
<p class="grid-empty t-meta" data-grid-empty hidden>No sections match this filter yet.</p>

<style is:global>
  /* Masonry: cards keep their own shape, in left-to-right order. Without the layout
     script this is a plain grid; uiMasonry (BaseLayout) sets each card's row span. */
  .section-grid {
    --cols: 2;
    --gap: 10px;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap);
    align-items: start;
  }
  @media (min-width: 720px) { .section-grid { --cols: 3; --gap: 14px; } }
  /* Four columns at most, however wide the screen. */
  @media (min-width: 1100px) { .section-grid { --cols: 4; } }
  .section-grid.is-masonry { grid-auto-rows: 2px; row-gap: 0; }

  .card { position: relative; min-width: 0; }
  .card:not(.eager) { content-visibility: auto; contain-intrinsic-size: auto 240px; }
  .card[hidden] { display: none; }

  .card .thumb {
    display: block;
    aspect-ratio: 1 / var(--r, 0.625);
    border-radius: 16px;
    corner-shape: squircle;
    background: var(--shot-bg, var(--wash));
    transition: box-shadow 0.3s var(--ease-out), translate 0.3s var(--ease-out), scale 0.2s var(--ease-spring);
  }
  .card .thumb img { display: block; width: 100%; height: 100%; }
  .card .thumb img.cover { object-fit: cover; object-position: top center; }
  .card .thumb img.contain { object-fit: contain; object-position: center; }

  @media (hover: hover) {
    .card .thumb:hover { box-shadow: 0 0 0 1px rgb(var(--ink-rgb) / 0.06), 0 14px 32px -12px rgb(var(--ink-rgb) / 0.22); translate: 0 -3px; }
  }
  .card .thumb:active { scale: 0.985; transition-duration: 90ms; }
  @media (max-width: 719px) { .card .thumb { border-radius: 12px; } }

  /* Entrances: first rows settle in (transform only, never invisible); the rest rise as they scroll in. */
  @media (prefers-reduced-motion: no-preference) {
    .card.eager { animation: rise-solid 0.7s var(--ease-out-expo) both; animation-delay: calc(0.08s + var(--i) * 50ms); }
    @supports (animation-timeline: view()) {
      .card:not(.eager) { animation: wall-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 45%; }
    }
  }
  @keyframes rise-solid { from { transform: translateY(14px); } }
  @keyframes wall-rise { from { opacity: 0; transform: translateY(14px); } }
</style>
