---
// Compact section-type index: small thumbnail, name and count per tile.
import Icon from './Icon.astro';
import type { Category } from '../lib/data';
import { getSection } from '../lib/data';
import { shotUrl } from '../lib/urls';

interface Props { items: Category[] }
const { items } = Astro.props;
---
<ul class="type-tiles">
  {items.map((c) => {
    const s = c.covers[0] ? getSection(c.covers[0]) : undefined;
    return (
      <li>
        <a class="tile" href={c.path}>
          <span class="thumb" style={s ? `--shot-bg:${s.bg}` : undefined}>
            {s && <img src={shotUrl(s.files['480'])} width={s.thumb.w} height={s.thumb.h} alt="" loading="lazy" decoding="async" />}
          </span>
          <span class="text">
            <span class="name">{c.label}</span>
            <span class="count tabular">{c.count.toLocaleString('en-US')} sections</span>
          </span>
          <Icon name="arrow-right" size={16} class="arrow" />
        </a>
      </li>
    );
  })}
</ul>

<style>
  .type-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (min-width: 760px) { .type-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; } }
  @media (min-width: 1100px) { .type-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .tile {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 8px 12px 8px 8px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .thumb {
    flex: none;
    position: relative;
    width: 72px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--shot-bg, var(--wash));
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.1);
    transition: translate 0.26s var(--ease-spring);
  }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .text { display: grid; min-width: 0; flex: 1; }
  .name { font-size: 0.9375rem; font-weight: 570; line-height: 1.3; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .count { font-size: 0.8125rem; line-height: 1.35; color: var(--ink-4); }
  .tile :global(.arrow) { flex: none; color: var(--ink-3); opacity: 0; translate: -4px 0; transition: opacity 0.2s, translate 0.26s var(--ease-spring); }

  @media (hover: hover) {
    .tile:hover { background: var(--wash); box-shadow: inset 0 0 0 1px transparent; }
    .tile:hover .thumb { translate: 0 -2px; }
    .tile:hover :global(.arrow) { opacity: 1; translate: 0 0; }
  }
  .tile:active { scale: 0.99; }

  /* Phones: text-only tiles so full names and counts fit two per row. */
  @media (max-width: 480px) {
    .tile { padding: 12px 14px; }
    .thumb, .tile :global(.arrow) { display: none; }
    .name { font-size: 0.875rem; white-space: normal; }
  }
</style>
